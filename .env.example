# ---------------------------------------------------------------------------
# CallSentry configuration
#
# Run `make env` to generate this file with fresh secrets, or `make keygen`
# to print a new set. Everything below the "local mode" block is optional.
# ---------------------------------------------------------------------------

# Local-first mode. 1 = never call a paid API for STT/LLM/TTS/embeddings,
# even if keys are present. Telephony (Twilio) is exempt - there is no
# local substitute for a phone number.
CALLSENTRY_LOCAL_ONLY=1

# --- Secrets (required; `make env` fills these in) -------------------------
# ENCRYPTION_KEY is 32 bytes, urlsafe-base64. Used for AES-256-GCM of
# per-business credentials at rest. Rotating it orphans stored credentials.
ENCRYPTION_KEY=
JWT_SECRET=
INTERNAL_API_TOKEN=

POSTGRES_PASSWORD=callsentry

# --- Host port mappings ----------------------------------------------------
# Only needed if something else on the machine already owns these ports.
APP_PORT=8000
DASHBOARD_PORT=3000
PIPECAT_PORT=8080
WORKER_PORT=8100
OLLAMA_PORT=11434
POSTGRES_PORT=5432
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Public URLs -----------------------------------------------------------
# PUBLIC_BASE_URL is what Twilio hits for webhooks. For local dev, point a
# tunnel at :8000 (e.g. `cloudflared tunnel --url http://localhost:8000`)
# and paste the https URL here. PUBLIC_WS_URL must be wss:// in production.
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8000
CALLSENTRY_DOMAIN=localhost

# --- Telephony (the only unavoidable paid component) -----------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional cloud fallbacks ---------------------------------------------
# Each is used only when CALLSENTRY_LOCAL_ONLY=0 AND the local provider for
# that component is unhealthy. Leave blank to stay fully local.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
RETELL_API_KEY=
OPENAI_API_KEY=

# --- Calendar --------------------------------------------------------------
# Point CALCOM_BASE_URL at your self-hosted Cal.com to stay local.
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com/v1

# --- Local model selection -------------------------------------------------
WHISPER_MODEL=base.en
KOKORO_VOICE=af_heart
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Compliance ------------------------------------------------------------
RECORDING_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=365

LOG_LEVEL=INFO
